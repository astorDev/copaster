<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>copaster-paste</ToolCommandName>
    <RootNamespace>Copaster</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.CommandLine" />
    <Using Include="NiceShell" />
    <Using Include="Copaster" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\magic\cli\Copaster.Magic.Cli.csproj" />
    <ProjectReference Include="..\..\io\lib\Copaster.IO.csproj" />
  </ItemGroup>

</Project>
