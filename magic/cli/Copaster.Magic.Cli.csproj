<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>copaster-magic</ToolCommandName>
    <RootNamespace>Copaster</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NiceShell.Cli" Version="2026.108.104.12" />
    <PackageReference Include="NiceShell.Logger" Version="2026.109.105.7" />
    <PackageReference Include="Tell.Makefile" Version="2026.109.104.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.CommandLine" />
    <Using Include="NiceShell" />
  </ItemGroup>

</Project>
